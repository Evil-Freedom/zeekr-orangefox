# ============================================================================
# zeekr (Motorola Razr 40 Ultra) —— TWRP / OrangeFox recovery.fstab
# 本文件内容基于 V-3.1 成品 ramdisk 中 system/etc/twrp.flags 真实提取，
# 分区布局/块设备节点/加密标志均与实机一致，可直接用于编译。
#
# 格式: <mount_point>  <fs_type>  <device>  <device2>  flags=...
# ============================================================================

# ---------- Boot / 引导分区 (A/B, slotselect) ----------
/boot            emmc   /dev/block/bootdevice/by-name/boot          flags=display="Boot";wipeingui;slotselect;backup=1;flashimg=1
/dtbo            emmc   /dev/block/bootdevice/by-name/dtbo          flags=display="DTBO";wipeingui;slotselect;backup=1;flashimg=1
/vendor_boot     emmc   /dev/block/bootdevice/by-name/vendor_boot   flags=display="Vendor Boot";wipeingui;slotselect;backup=1;flashimg=1
/vbmeta          emmc   /dev/block/bootdevice/by-name/vbmeta        flags=display="VBMeta";wipeingui;slotselect;backup=1;flashimg=1
/vbmeta_system   emmc   /dev/block/bootdevice/by-name/vbmeta_system flags=display="System VBMeta";wipeingui;slotselect;backup=1;flashimg=1
/recovery        emmc   /dev/block/bootdevice/by-name/recovery      flags=display="Recovery";wipeingui;slotselect;backup=1;flashimg=1
/logo            emmc   /dev/block/bootdevice/by-name/logo          flags=display="Logo";wipeingui;slotselect;backup=1;flashimg=1
/misc            emmc   /dev/block/bootdevice/by-name/misc          flags=display="Misc";wipeingui;slotselect;backup=1;flashimg=1

# ---------- 动态分区 (super, logical) ----------
/system          ext4   system   flags=display="System"
/system          erofs  system   flags=display="System"
/system_ext      ext4   system_ext   flags=display="System EXT"
/system_ext      erofs  system_ext   flags=display="System EXT"
/product         ext4   product  flags=display="Product"
/product         erofs  product  flags=display="Product"
/vendor          ext4   vendor   flags=display="Vendor"
/vendor          erofs  vendor   flags=display="Vendor"
/vendor_dlkm     ext4   vendor_dlkm  flags=display="Vendor DLKM"
/vendor_dlkm     erofs  vendor_dlkm  flags=display="Vendor DLKM"

# ---------- Data (FBE + metadata 加密, f2fs) ----------
/data            f2fs   /dev/block/bootdevice/by-name/userdata  flags=display="Data";wipeingui;backup=1;flashimg=1;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0;fsflags="noatime,nosuid,nodev,discard,inlinecrypt,reserve_root=32768,resgid=1065,fsync_mode=nobarrier"
/metadata        ext4   /dev/block/by-name/metadata  flags=display="Metadata";wipeingui;backup=1;flashimg=1

# ---------- 固件分区 ----------
/persist         ext4   /dev/block/bootdevice/by-name/persist  flags=display="Persist"
/prodpersist     ext4   /dev/block/bootdevice/by-name/prodpersist  flags=display="Product Persist"
/firmware        ext4   /dev/block/bootdevice/by-name/modem  flags=display="Firmware";fsflags="context=u:object_r:firmware_file:s0"
/bt_firmware     ext4   /dev/block/bootdevice/by-name/bluetooth  flags=display="Bluetooth";fsflags="context=u:object_r:bt_firmware_file:s0"
/fsg             emmc   /dev/block/bootdevice/by-name/fsg  flags=display="FSG";fsflags="context=u:object_r:fsg_file:s0"
/dsp             emmc   /dev/block/bootdevice/by-name/dsp  flags=display="DSP";backup=1;flashimg=1
/modem_image     emmc   /dev/block/bootdevice/by-name/modem  flags=display="Modem";wipeingui;slotselect;backup=1;flashimg=1
/bluetooth_image emmc   /dev/block/bootdevice/by-name/bluetooth  flags=display="Bluetooth";wipeingui;slotselect;backup=1;flashimg=1
/efs1            emmc   /dev/block/bootdevice/by-name/modemst1  flags=display="EFS";backup=1
/efs2            emmc   /dev/block/bootdevice/by-name/modemst2  flags=backup=1;subpartitionof=/efs1
/efsc            emmc   /dev/block/bootdevice/by-name/fsc  flags=backup=1;subpartitionof=/efs1
/efsg            emmc   /dev/block/bootdevice/by-name/fsg  flags=backup=1;subpartitionof=/efs1
/abl             emmc   /dev/block/bootdevice/by-name/abl  flags=display="abl";wipeingui;slotselect;backup=1;flashimg=1
/aop             emmc   /dev/block/bootdevice/by-name/aop  flags=display="aop";wipeingui;slotselect;backup=1;flashimg=1
/aop_config      emmc   /dev/block/bootdevice/by-name/aop_config  flags=display="aop_config";wipeingui;slotselect;backup=1;flashimg=1
