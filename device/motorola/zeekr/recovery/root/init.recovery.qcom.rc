# FBE v2 解密链（QSEE / KeyMint / Gatekeeper）
# 原 import /init.recovery.qcom_decrypt.rc 指向的文件不存在，导致解密 HAL 全挂不起。
# 改为自包含：先挂 binderfs，再起 qseecomd；qseecomd 设 vendor.sys.listeners.registered=true 后，
# KeyMint 与 Gatekeeper 由各自 vendor/etc/init/*.rc 按属性自动拉起。
on init
    mkdir /dev/binderfs 0700 root root
    mount binder binder /dev/binderfs stats=global
    symlink /dev/binderfs/binder /dev/binder
    symlink /dev/binderfs/hwbinder /dev/hwbinder
    symlink /dev/binderfs/vndbinder /dev/vndbinder

on early-init
    start set_permissive

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on property:init.svc.fastbootd=running
    # 模块由 TW_LOAD_VENDOR_MODULES 在启动早期统一加载，这里不再重复 insmod。
    # 原来这段里的 touchscreen_mmi.ko 和 sx937x_sar.ko 在 ramdisk 里根本不存在
    # （实际文件名是 sx937x_multi.ko），insmod 失败会在 fastbootd 切换时卡顿。
    setprop twrp.modules.loaded true

on post-fs && property:init.svc.fastbootd=stopped
    # Trigger loading kernel modules in normal mode
    setprop twrp.modules.loaded true

on property:twrp.modules.loaded=true
    # Load kernel modules and ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    start runatboot
    wait /sys/class/power_supply/battery

on post-fs
    start boot-hal-1-2

on boot
    # 先起 QSEE，注册 listener 后 KeyMint/Gatekeeper 才能绑定
    start qseecomd
    start health-hal-2-1

service set_permissive /system/bin/set_permissive.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service runatboot /system/bin/runatboot.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service qseecomd /system/bin/qseecomd
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0
